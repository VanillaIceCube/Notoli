FROM node:26@sha256:e18c3ccdf7d71619990b0e85639f506e2028a95410999cab24cc373cbd10e0ac

# Set working directory
WORKDIR /frontend

# Copy package.json and package-lock.json and install Node.js dependencies
COPY package*.json ./
RUN npm ci

# Copy your React project code
COPY . .

ENV HOST=0.0.0.0

# Document dev server port
EXPOSE 3000

# Run React server
CMD ["npm", "start"]
