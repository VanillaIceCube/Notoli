FROM node:26@sha256:f8e5d4bb28fa55c74f1345166a082a10b7c68f22304350c1ce0d18358ae94996

# Set working directory
WORKDIR /frontend

# Copy package.json and package-lock.json and install Node.js dependencies
COPY package*.json ./
RUN npm ci

# Copy your React project code
COPY . .

ENV HOST=0.0.0.0

# Document dev server port
EXPOSE 3000

# Run React server
CMD ["npm", "start"]
