{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "axios": "^1.21.0",
    "eslint-config-prettier": "^10.1.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.13.3",
    "globals": "^17.14.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "jsdom": "^31.0.0",
    "@playwright/test": "^1.65.0"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run lint:strict && vite build",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:strict": "eslint \"src/**/*.{js,jsx}\" --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:watch": "vitest",
    "test:e2e": "node ../scripts/run_e2e.cjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "minimatch@>=9 <11.0.1": "^11.0.1",
    "glob@>=9 <14.0.2": "^14.0.2"
  }
}
