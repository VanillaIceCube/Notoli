FROM node:26@sha256:438603bbb5cda404b9416f0b5c8026f61501ab911760d861ec28c36b5d675725

# Set working directory
WORKDIR /frontend

# Copy package.json and package-lock.json and install Node.js dependencies
COPY package*.json ./
RUN npm ci

# Copy your React project code
COPY . .

ENV HOST=0.0.0.0

COPY docker-entrypoint-dev.sh /usr/local/bin/docker-entrypoint-dev
RUN chmod +x /usr/local/bin/docker-entrypoint-dev

# Document dev server port
EXPOSE 3000

# Run React server
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-dev"]
CMD ["npm", "start"]
