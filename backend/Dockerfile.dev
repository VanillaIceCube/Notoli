# Miniforge 24.04, pinned for reproducible development builds. Update this
# digest only after an explicit image-version and security review.
FROM condaforge/miniforge3@sha256:3a41fcca7d6740df102951d9f122bf1a5f81170fdba234243060f72eb4891901

WORKDIR /backend

COPY environment.yml requirements.txt ./
RUN conda env create -f environment.yml && conda clean --all -y

ENV PATH="/opt/conda/envs/notoli_env/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=app.settings \
    PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
