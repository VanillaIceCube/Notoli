# Local Docker settings
# Copy this file to deploy/.env and put private values in that copy.
# Production settings are supplied separately through release bundles.

# Backend
DJANGO_DEBUG=1
# Set a stable private key for local HTTPS.
# Hotswap provides a development-only fallback when this is blank.
DJANGO_SECRET_KEY=
DJANGO_SQLITE_PATH=/backend/db.sqlite3
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,notoli.localhost

# Browser origins
DJANGO_CORS_ALLOWED_ORIGINS=https://notoli.localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://notoli.localhost
DJANGO_FRONTEND_BASE_URL=https://notoli.localhost

# MCP and proxy trust
# Set to 1 to enable the app-owned MCP server locally.
DJANGO_MCP_ENABLED=0
DJANGO_MCP_BASE_URL=https://notoli.localhost
# Compose sets exact proxy trust for HTTPS and clears it for hotswap.
DJANGO_TRUSTED_PROXY_IPS=

# Email
# Console delivery prints messages locally without sending email.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.resend.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_HOST_USER=resend
DJANGO_EMAIL_HOST_KEY=
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=notoli@example.invalid

# Local HTTPS
# If you change the HTTPS port, update the origin to match.
# Example: https://notoli.localhost:8443
NOTOLI_HTTP_PORT=80
NOTOLI_HTTPS_PORT=443
NOTOLI_HTTPS_ORIGIN=https://notoli.localhost
# Certificate paths are relative to deploy/.
NOTOLI_CERTS_DIR=../certs

# Hotswap ports
# Both ports bind to localhost only.
NOTOLI_DEV_BACKEND_PORT=8000
NOTOLI_DEV_FRONTEND_PORT=3000
