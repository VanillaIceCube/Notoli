# Backend
DJANGO_DEBUG=1
# Required by the production stack. The development Compose file safely falls
# back to a development-only value when this remains blank.
DJANGO_SECRET_KEY=
DJANGO_SQLITE_PATH=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_FORCE_SCRIPT_NAME=
DJANGO_FRONTEND_BASE_URL=
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=
DJANGO_EMAIL_USE_TLS=
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_KEY=
DJANGO_EMAIL_TIMEOUT=
DJANGO_DEFAULT_FROM_EMAIL=

# Development Compose host-port overrides (localhost-only bindings).
NOTOLI_DEV_BACKEND_PORT=8000
NOTOLI_DEV_FRONTEND_PORT=3000
