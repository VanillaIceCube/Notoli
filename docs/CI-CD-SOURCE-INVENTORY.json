    "ci-auto-merge.yml": {
      "credential_names": [],
      "events": {
        "workflow_run": {
          "types": [
            "completed"
          ],
          "workflows": [
            "CI"
          ]
        }
      },
      "jobs": {
        "dependabot-auto-merge": {
          "if": "github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'pull_request'",
          "name": "Dependabot Auto Merge",
          "permissions": {
            "actions": "read",
            "checks": "write",
            "contents": "write",
            "pull-requests": "write",
            "vulnerability-alerts": "read"
          }
        }
      },
      "name": "Dependabot Auto Merge",
      "permissions": {
        "contents": "read"
      },
      "source_sha256": "7c034be23ef8564af16a927c7edeb57f5f1b2c334d7a805b5fee0af6ee6391d6",
      "variable_names": [
        "LINT_EASTWOOD_REVIEWER_LOGIN",
        "OBI_WAN_REVIEWER_LOGIN",
        "ROBOCOP_REVIEWER_LOGIN"
      ]
    },
    "ci-deploy.yml": {
      "credential_names": [
        "DEPLOY_SSH_KEY",
        "DJANGO_EMAIL_HOST_KEY",
        "DJANGO_SECRET_KEY",
        "GITHUB_TOKEN"
      ],
      "events": {
        "push": {
          "branches": [
            "env-prod"
          ]
        },
        "workflow_dispatch": ""
      },
      "jobs": {
        "build-and-deploy": {
          "if": "github.ref == 'refs/heads/env-prod'"
        }
      },
