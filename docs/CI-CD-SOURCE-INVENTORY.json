        "DJANGO_EMAIL_PORT",
        "DJANGO_EMAIL_TIMEOUT",
        "DJANGO_EMAIL_USE_TLS"
      ]
    },
    "ci-orchestrator.yml": {
      "credential_names": [
        "LINT_EASTWOOD_OPENAI_API_KEY",
        "LINT_EASTWOOD_PRIVATE_KEY",
        "OBI_WAN_CODE_NOBI_PRIVATE_KEY",
        "OBI_WAN_OPENAI_API_KEY",
        "ROBOCOP_OPENAI_API_KEY",
        "ROBOCOP_PRIVATE_KEY"
      ],
      "events": {
        "pull_request": {
          "branches-ignore": [
            "env-prod"
          ],
          "types": [
            "opened",
            "synchronize",
            "reopened",
            "ready_for_review"
          ]
        }
      },
      "jobs": {
        "auto-merge": {
          "if": "always()",
          "name": "Auto Merge",
          "needs": [
            "lints",
            "tests",
            "codeql",
            "dependency-vulnerability",
            "dependency-malware",
            "code-review",
            "build-review",
            "security-review"
          ],
          "permissions": {
            "contents": "read"
          }
        },
        "build-review": {
          "if": "always() && github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Build Sheriff Review",
          "needs": [
            "lints",
            "tests"
          ],
          "permissions": {
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-build.yml"
        },
        "code-review": {
          "if": "github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Code Review",
          "permissions": {
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-code.yml"
        },
        "codeql": {
          "name": "CodeQL",
          "permissions": {
            "actions": "read",
            "contents": "read",
            "pull-requests": "read",
            "security-events": "write"
          },
          "uses": "./.github/workflows/gate-codeql.yml"
        },
        "dependency-malware": {
          "name": "Malware",
          "permissions": {
            "contents": "read",
            "pull-requests": "read"
          },
          "uses": "./.github/workflows/gate-malware.yml"
        },
        "dependency-vulnerability": {
          "name": "Vulnerability",
          "permissions": {
            "contents": "read",
            "pull-requests": "read"
          },
          "uses": "./.github/workflows/gate-vulnerability.yml"
        },
        "lints": {
          "name": "Lints",
          "uses": "./.github/workflows/gate-lint.yml"
        },
        "security-review": {
          "if": "always() && github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Security Review",
          "needs": [
            "codeql",
            "dependency-vulnerability",
            "dependency-malware"
          ],
          "permissions": {
            "actions": "read",
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "security-events": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-security.yml"
        },
        "tests": {
          "name": "Tests",
          "uses": "./.github/workflows/gate-test.yml"
        }
      },
      "name": "CI",
      "permissions": {
        "contents": "read",
        "pull-requests": "write"
      },
      "source_sha256": "d5e6753d498cea787172a0abfc79d13325a436632a638abaedc959f90ecbc035",
      "variable_names": []
    },
    "gate-codeql.yml": {
      "credential_names": [],
      "events": {
        "push": {
          "branches": [
            "main"
          ],
          "paths": [
            "backend/**",
            "frontend/**",
            ".github/actions/**",
            ".github/workflows/**",
            ".github/codeql/**"
          ]
        },
        "schedule": [
          {
            "cron": "24 10 * * 1"
          }
        ],
        "workflow_call": {
          "outputs": {
            "scope_actions": {
              "description": "Whether the pull request requires GitHub Actions analysis.",
              "value": "${{ jobs.changes.outputs.actions }}"
            },
            "scope_javascript": {
              "description": "Whether the pull request requires JavaScript/TypeScript analysis.",
              "value": "${{ jobs.changes.outputs.javascript }}"
            },
            "scope_python": {
              "description": "Whether the pull request requires Python analysis.",
              "value": "${{ jobs.changes.outputs.python }}"
            },
            "scope_status": {
              "description": "Whether path-aware CodeQL scope detection succeeded.",
              "value": "${{ jobs.changes.outputs.scope_status }}"
            }
          }
        },
        "workflow_dispatch": ""
      },
      "jobs": {
        "analyze-actions": {
          "if": "needs.changes.outputs.actions == 'true'",
          "name": "Analyze GitHub Actions",
          "needs": "changes",
          "permissions": {
            "actions": "read",
            "contents": "read",
            "pull-requests": "read",
            "security-events": "write"
          }
        },
        "analyze-javascript": {
          "if": "needs.changes.outputs.javascript == 'true'",
          "name": "Analyze JavaScript/TypeScript",
          "needs": "changes",
          "permissions": {
            "actions": "read",
            "contents": "read",
            "pull-requests": "read",
            "security-events": "write"
          }
        },
        "analyze-python": {
          "if": "needs.changes.outputs.python == 'true'",
          "name": "Analyze Python",
          "needs": "changes",
          "permissions": {
            "actions": "read",
            "contents": "read",
            "pull-requests": "read",
            "security-events": "write"
          }
        },
        "changes": {
          "name": "Detect CodeQL Scope",
          "permissions": {
            "contents": "read",
            "pull-requests": "read"
          }
        }
      },
      "name": "CodeQL Gate",
      "permissions": {
        "actions": "read",
        "contents": "read",
        "pull-requests": "read",
        "security-events": "write"
      },
      "source_sha256": "735046b86174afda3d879a44a987fa72c8ab1f7bda5341d6b0044be1c82a244e",
      "variable_names": []
    },
    "gate-lint.yml": {
      "credential_names": [
        "LINT_EASTWOOD_PRIVATE_KEY"
      ],
      "events": {
        "workflow_call": {
          "inputs": {
            "checkout_ref": {
              "description": "Branch or ref to check out for auto-fix commits.",
              "required": "false",
              "type": "string"
            },
            "enable_autofix": {
              "default": "false",
              "description": "Allow lint fixes to be committed and pushed for a trusted same-repository branch.",
              "required": "false",
              "type": "boolean"
            }
          },
          "outputs": {
            "lint_backend_log": {
              "description": "Backend lint log tail.",
              "value": "${{ jobs.lint-results.outputs.backend_log }}"
            },
            "lint_backend_status": {
              "description": "Backend lint status (success/failure/not-applicable).",
              "value": "${{ jobs.lint-results.outputs.backend_status }}"
            },
            "lint_frontend_log": {
              "description": "Frontend lint log tail.",
              "value": "${{ jobs.lint-results.outputs.frontend_log }}"
            },
            "lint_frontend_status": {
              "description": "Frontend lint status (success/failure/not-applicable).",
              "value": "${{ jobs.lint-results.outputs.frontend_status }}"
            }
          },
          "secrets": {
            "LINT_EASTWOOD_PRIVATE_KEY": {
              "required": "false"
            }
          }
        }
      },
      "jobs": {
        "changes": {
          "name": "Detect Changes"
        },
        "lint-backend": {
          "if": "needs.changes.outputs.backend == 'true'",
          "name": "Lint Backend (Ruff)",
          "needs": "changes"
        },
        "lint-frontend": {
          "if": "needs.changes.outputs.frontend == 'true'",
          "name": "Lint Frontend (ESLint + Prettier)",
          "needs": "changes"
        },
        "lint-results": {
          "if": "always()",
          "name": "Lint Results",
          "needs": [
            "changes",
            "lint-frontend",
            "lint-backend"
          ]
        }
      },
      "name": "Lint Gate",
      "permissions": {
        "contents": "read",
        "pull-requests": "read"
      },
      "source_sha256": "8ec799d0120fd29a332327289f78e81cff7ec81ccd86213e771bb602ef255f75",
      "variable_names": [
        "LINT_EASTWOOD_APP_ID"
      ]
    },
